# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password
POSTGRES_DB=chatbot

# Backend connection strings (inside docker-compose network)
DATABASE_URL=postgresql://admin:admin_password@postgres:5432/chatbot
REDIS_URL=redis://redis:6379/0

# JWT signing secret (replace in real usage)
SECRET_KEY=your_super_secret_production_key

